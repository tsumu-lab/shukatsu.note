// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id          Int          @id @default(autoincrement())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  mypageUrl   String?
  mypageId    String?
  mypagePw    String?
  deadline    DateTime?
  priority    Int          @default(3)
  status      String       @default("検討中")
  memo        String?
  memoImage   String?
  entrySheets EntrySheet[]
  reminders   Reminder[]
  interviews  Interview[]
  internNotes InternNote[]
  memoEntries MemoEntry[]
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?    // ★追加
  pinned Boolean @default(false)
  updatedAt    DateTime  @updatedAt // ★追加：更新のたびに自動で記録される
  lastViewedAt DateTime? // ★追加：企業ページを開いた日時
}

model EntrySheet {
  id        Int       @id @default(autoincrement())
  company   Company   @relation(fields: [companyId], references: [id])
  companyId Int
  question  String
  answer    String
  memo      String?
  maxLength Int?      // ★追加：文字数の上限（任意）
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // ★追加
  pinned Boolean @default(false)
}

model Reminder {
  id        Int       @id @default(autoincrement())
  company   Company?  @relation(fields: [companyId], references: [id])
  companyId Int?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  dueDate   DateTime?
  completed Boolean   @default(false)
  memo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Interview {
  id        Int       @id @default(autoincrement())
  company   Company   @relation(fields: [companyId], references: [id])
  companyId Int
  question  String
  answer    String?
  memo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // ★追加
  pinned Boolean @default(false)
}

model InternNote {
  id        Int       @id @default(autoincrement())
  company   Company   @relation(fields: [companyId], references: [id])
  companyId Int
  title     String?   // ★追加
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt // ★追加
  deletedAt DateTime? // ★追加
  pinned Boolean @default(false)
}

model MemoEntry {
  id        Int       @id @default(autoincrement())
  company   Company   @relation(fields: [companyId], references: [id])
  companyId Int
  title     String?   // ★追加
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // ★追加
  pinned Boolean @default(false)
}

model PersonalNote {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  category  String    @default("self_pr")
  title     String?   // ★変更：メモ系はタイトル無しで使うため任意に
  content   String
  pinned    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // ★追加：企業メモと同じ「空になったら自動削除」に対応
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  companies     Company[]
  personalNotes PersonalNote[]
  accounts      Account[]
  sessions      Session[]
  reminders     Reminder[] // ★追加
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}